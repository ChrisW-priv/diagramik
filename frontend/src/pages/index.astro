---
// Root page - redirects to login or diagrams based on auth status
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>
  </head>
  <body style="margin:0;display:flex;align-items:center;justify-content:center;height:100vh;background:#0f172a;color:#94a3b8;font-family:system-ui,sans-serif">
    <p>Loading...</p>
    <script>
      const TOKEN_STORAGE_KEY = 'diagramik_tokens';
      const isAuthenticated = localStorage.getItem(TOKEN_STORAGE_KEY) !== null;

      if (isAuthenticated) {
        window.location.href = '/diagrams';
      } else {
        window.location.href = '/login';
      }
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/login" />
    </noscript>
  </body>
</html>
