---
import SetNewPasswordForm from '../../components/SetNewPasswordForm.vue';

// Get uid and token from query params
const url = new URL(Astro.request.url);
const uid = url.searchParams.get('uid');
const token = url.searchParams.get('token');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Generate technical diagrams from natural language. Describe your architecture in plain text and get a diagram instantly." />
    <title>Diagramik | Set New Password</title>
  </head>
  <body>
    <SetNewPasswordForm uid={uid ?? undefined} token={token ?? undefined} client:only="vue" />
  </body>
</html>
