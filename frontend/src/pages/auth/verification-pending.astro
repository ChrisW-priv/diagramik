---
import Layout from '../../layouts/Layout.astro';
import VerificationPendingView from '../../components/VerificationPendingView.vue';

// Get email from query params if present
const url = new URL(Astro.request.url);
const emailParam = url.searchParams.get('email');
---

<Layout title="Diagramik | Verify Your Email">
  <VerificationPendingView initialEmail={emailParam ?? undefined} client:only="vue" />
</Layout>
